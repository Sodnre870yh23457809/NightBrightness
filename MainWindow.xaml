<Window x:Class="NightBrightness.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Night Brightness" Width="1040" Height="930" MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen"
 Background="#212121" Foreground="#ECECEC" FontFamily="Segoe UI" FontSize="14" Icon="NightBrightness.ico"
 Closing="WindowClosing" SourceInitialized="WindowReady">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#212121"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border Background="#555555" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="Muted" Color="#A6A6A6"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECECEC"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#A6A6A6"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#292929"/><Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#353535"/><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Padding" Value="17,10"/>
   <Setter Property="BorderBrush" Value="#505050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Navigation" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#B4B4B4"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303030"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A2A2A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AAAAAA"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#202020"/><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#505050"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B9DAD0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel><Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="23" CornerRadius="12" Background="#555555" Margin="18,0,0,0"><Ellipse x:Name="Thumb" Width="17" Height="17" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#B9DAD0"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#1D3930"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="TickFrequency" Value="1"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="28"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="#B9DAD0" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="20"><Thumb.Template><ControlTemplate><Ellipse Width="15" Height="15" Fill="#EEEEEE"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="#525252" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171717" BorderBrush="#303030" BorderThickness="0,0,1,0">
   <Grid Margin="16,26,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,32"><Image Source="NightBrightness.png" Width="38" Height="38" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="Night Brightness" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="A softer end to your day." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><RadioButton x:Name="ScheduleNav" GroupName="Navigation" Style="{StaticResource Navigation}" Content="◷    Schedule" Tag="Schedule" Checked="Navigate" IsChecked="True"/><RadioButton GroupName="Navigation" Style="{StaticResource Navigation}" Content="☷    Preferences" Tag="Preferences" Checked="Navigate"/><RadioButton GroupName="Navigation" Style="{StaticResource Navigation}" Content="ⓘ    About" Tag="About" Checked="Navigate"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="10,0,0,0"><TextBlock x:Name="SidebarStatus" Text="●  Running in background" FontSize="11" Foreground="#B9DAD0"/><TextBlock Text="Local. Quiet. Automatic." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="32,28,32,22"><StackPanel><TextBlock x:Name="PageTitle" Text="Your daily rhythm" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Comfortable screens, from morning to night." Foreground="#A6A6A6" Margin="0,7,0,0"/></StackPanel></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,8">
    <StackPanel>
     <StackPanel x:Name="SchedulePage">
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LiveStatus" Text="Night schedule active" Foreground="#B9DAD0" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="LiveBrightness" Text="0%" FontSize="40" FontWeight="SemiBold"/><TextBlock x:Name="MonitorLabel" Text="on both monitors" Foreground="#A6A6A6" VerticalAlignment="Bottom" Margin="14,0,0,10"/></StackPanel><TextBlock x:Name="NextEvent" Style="{StaticResource Caption}" Text="Light mode and 55% at 05:00"/></StackPanel><Button x:Name="PauseButton" Grid.Column="1" Content="Pause" VerticalAlignment="Center" Click="PauseClick"/></Grid></Border>
      <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="Brightness" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="SHARED VALUES" HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="10"/></Grid><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Grid><TextBlock Text="Day" Foreground="#BCBCBC"/><TextBlock x:Name="DayValue" Text="55%" HorizontalAlignment="Right"/></Grid><Slider x:Name="DaySlider" Value="55" Margin="0,10,0,0" ValueChanged="Edited" AutomationProperties.Name="Day brightness"/><TextBlock Text="A little brighter for your day." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><Grid><TextBlock Text="Night" Foreground="#BCBCBC"/><TextBlock x:Name="NightValue" Text="0%" HorizontalAlignment="Right"/></Grid><Slider x:Name="NightSlider" Value="0" Margin="0,10,0,0" ValueChanged="Edited" AutomationProperties.Name="Night brightness"/><TextBlock Text="Wind down with a softer screen." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Grid><Button Content="Preview night · 10 seconds" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="12,7" FontSize="12" Click="PreviewClick"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <CheckBox x:Name="MonitorBrightnessToggle" Checked="OptionEdited" Unchecked="OptionEdited" AutomationProperties.Name="Different brightness for each monitor"><TextBlock Text="Different brightness for each monitor" FontSize="17" FontWeight="SemiBold"/></CheckBox>
       <TextBlock Text="Set separate day and night levels. Both monitors follow the same times and fade; other displays use the shared values above." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       <StackPanel x:Name="MonitorBrightnessPanel" Visibility="Collapsed"/>
       <Button Content="Refresh monitors" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,7" FontSize="12" Click="RefreshMonitorsClick"/>
       <TextBlock x:Name="MonitorLiveValues" Foreground="#B9DAD0" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <CheckBox x:Name="SolarToggle" Checked="OptionEdited" Unchecked="OptionEdited" AutomationProperties.Name="Follow sunrise and sunset"><TextBlock Text="Follow sunrise and sunset" FontSize="17" FontWeight="SemiBold"/></CheckBox>
       <TextBlock Text="Use your location to adjust every day. Night begins at sunset; day begins at sunrise." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,13,0,0"/>
       <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="CityBox" AutomationProperties.Name="City or town" FontSize="14" ToolTip="Search by city, town, or city and country"/>
        <Button x:Name="SearchCityButton" Grid.Column="2" Content="Search city" Click="SearchCityClick" Padding="13,8"/>
       </Grid>
       <StackPanel x:Name="CityResults" Visibility="Collapsed" Margin="0,8,0,0"/>
       <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="LocateButton" Content="Use Windows location" Click="UseLocationClick" Padding="13,8"/>
        <TextBlock x:Name="SolarStatus" Grid.Column="1" Text="Fixed times are active." Foreground="#B9DAD0" VerticalAlignment="Center" Margin="15,0,0,0" TextWrapping="Wrap" FontSize="12"/>
       </Grid>
       <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Latitude · optional manual entry" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="LatitudeBox" TextChanged="CoordinateEdited" AutomationProperties.Name="Latitude"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Longitude" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="LongitudeBox" TextChanged="CoordinateEdited" AutomationProperties.Name="Longitude"/></StackPanel>
       </Grid>
       <TextBlock Text="City search sends the name you type to Open-Meteo. Saved coordinates and daily sunrise/sunset calculations stay on this PC. Windows location is optional." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,13,0,0"/>
      </StackPanel></Border>      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Timing" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Morning starts" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="MorningBox" Text="05:00" TextChanged="TextEdited" AutomationProperties.Name="Morning time"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Night reached by" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="NightBox" Text="21:00" TextChanged="TextEdited" AutomationProperties.Name="Night time"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Fade duration · min" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="FadeBox" Text="15" TextChanged="TextEdited" AutomationProperties.Name="Fade duration"/></StackPanel></Grid><TextBlock x:Name="FadeSummary" Text="Starts dimming at 20:45. Night brightness by 21:00." Foreground="#B9DAD0" FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap"/><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Canvas x:Name="Timeline" Height="64" SizeChanged="TimelineSized" ClipToBounds="True"/><Grid Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="00:00" Style="{StaticResource Caption}"/><TextBlock Text="12:00" HorizontalAlignment="Center" Style="{StaticResource Caption}"/><TextBlock Text="24:00" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid></Grid></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="PreferencesPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel>
       <CheckBox x:Name="WallpaperToggle" Checked="OptionEdited" Unchecked="OptionEdited" AutomationProperties.Name="Switch desktop wallpaper"><TextBlock Text="Switch desktop background" FontSize="17" FontWeight="SemiBold"/></CheckBox>
       <TextBlock Text="Pick a day image and a night image. The app will use the same image on both monitors at your scheduled sunrise and sunset." Foreground="#AAAAAA" TextWrapping="Wrap" LineHeight="21" Margin="0,13,0,0"/>
       <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <Border Background="#202020" BorderBrush="#454545" BorderThickness="1" CornerRadius="9" ClipToBounds="True" Height="110"><Grid><Image x:Name="DayWallpaperPreview" Stretch="UniformToFill"/><TextBlock x:Name="DayWallpaperPlaceholder" Text="No day image selected" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
         <TextBlock Text="Day image" FontWeight="SemiBold" Margin="0,11,0,6"/>
         <TextBox x:Name="DayWallpaperBox" IsReadOnly="True" FontSize="12" AutomationProperties.Name="Day wallpaper image" TextChanged="TextEdited"/>
         <Button Content="Choose day image" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7" Click="ChooseDayWallpaperClick"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <Border Background="#202020" BorderBrush="#454545" BorderThickness="1" CornerRadius="9" ClipToBounds="True" Height="110"><Grid><Image x:Name="NightWallpaperPreview" Stretch="UniformToFill"/><TextBlock x:Name="NightWallpaperPlaceholder" Text="No night image selected" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
         <TextBlock Text="Night image" FontWeight="SemiBold" Margin="0,11,0,6"/>
         <TextBox x:Name="NightWallpaperBox" IsReadOnly="True" FontSize="12" AutomationProperties.Name="Night wallpaper image" TextChanged="TextEdited"/>
         <Button Content="Choose night image" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7" Click="ChooseNightWallpaperClick"/>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="WallpaperSummary" Foreground="#B9DAD0" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="Keep the selected image files in place. Turning this off keeps the wallpaper currently on your desktop." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="ThemeToggle" IsChecked="True" Checked="OptionEdited" Unchecked="OptionEdited" AutomationProperties.Name="Switch Windows theme"><TextBlock Text="Switch Windows theme" FontSize="17" FontWeight="SemiBold"/></CheckBox><TextBlock Text="Dark at night. Light in the morning." Foreground="#B9DAD0" Margin="0,14,0,0"/><TextBlock Text="Windows and apps that follow its theme will switch at your morning and night times. Apps with a fixed theme keep their own preference." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,45,0"/><TextBlock x:Name="ThemeSummary" Margin="0,20,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="StartupToggle" IsChecked="True" Checked="OptionEdited" Unchecked="OptionEdited" AutomationProperties.Name="Start at sign-in"><TextBlock Text="Start when I sign in" FontSize="17" FontWeight="SemiBold"/></CheckBox><TextBlock Text="Starts quietly as soon as Windows signs you in. Your schedule applies immediately; the system tray remains available." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,45,0" LineHeight="21"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Always close at hand" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Closing this window keeps your schedule running. Open it again from the desktop shortcut or by double-clicking the tray icon." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/><Button Content="Restore day brightness" HorizontalAlignment="Left" Margin="0,20,0,0" Click="RestoreClick"/><TextBlock Text="A temporary override, until the next evening fade." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AboutPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><Image Source="NightBrightness.png" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,20"/><TextBlock Text="Night Brightness" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Made for a gentler daily rhythm." Foreground="#B9DAD0" Margin="0,10,0,20"/><TextBlock Text="A small Windows app that takes care of display brightness, Windows theme, and your desktop background. Daily adjustments run locally on your PC. City searches contact Open-Meteo only when you use Search city." TextWrapping="Wrap" Foreground="#BBBBBB" LineHeight="24"/><Separator Margin="0,22" Background="#454545"/><TextBlock Text="Good to know" FontWeight="SemiBold"/><TextBlock Text="•  NVIDIA monitors can use shared or individual brightness levels.&#10;•  Times follow your PC's local clock.&#10;•  0% is NVIDIA's minimum, not a powered-off screen.&#10;•  The app resumes the schedule after sleep.&#10;•  Your existing contrast and gamma are preserved." TextWrapping="Wrap" Foreground="#AAAAAA" LineHeight="26" Margin="0,12,0,0"/><Button Content="Open files and logs" HorizontalAlignment="Left" Margin="0,22,0,0" Click="OpenFolder"/><TextBlock Text="Version 2.0 · GPL-3.0-or-later" Style="{StaticResource Caption}" Margin="0,22,0,0"/></StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#212121" BorderBrush="#383838" BorderThickness="0,1,0,0" Padding="32,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveStatus" Text="Your schedule is up to date." Foreground="#A6A6A6" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" FontSize="12"/><Button Grid.Column="1" Content="Reset changes" Margin="0,0,10,0" Click="ResetClick"/><Button x:Name="SaveButton" Grid.Column="2" Content="Save changes" Background="#ECECEC" Foreground="#202020" BorderBrush="#ECECEC" FontWeight="SemiBold" Click="SaveClick"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
