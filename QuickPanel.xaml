<Window x:Class="NightBrightness.QuickPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Quick brightness" Width="338" Height="240" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Deactivated="PanelDeactivated" Loaded="PanelLoaded" Foreground="#ECECEC" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Slider">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="28"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="#B9DAD0" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="20"><Thumb.Template><ControlTemplate><Ellipse Width="15" Height="15" Fill="#EEEEEE"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="#525252" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources> <Border Background="#292929" BorderBrush="#505050" BorderThickness="1" CornerRadius="16" Padding="19">
  <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity=".4" Color="Black"/></Border.Effect>
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="NightBrightness.png" Width="26" Height="26"/>
    <TextBlock Grid.Column="1" Text="Night Brightness" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
    <Button Grid.Column="2" Content="×" Width="26" Height="26" FontSize="17" Padding="0" Click="CloseClick" Background="Transparent" Foreground="#A6A6A6" BorderThickness="0" Cursor="Hand"/>
   </Grid>
   <Grid Margin="0,17,0,5"><TextBlock x:Name="ValueText" FontSize="35" FontWeight="SemiBold" Text="55%"/><TextBlock x:Name="MonitorsText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="#AAAAAA" FontSize="12" Text="2 monitors"/></Grid>
   <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" AutomationProperties.Name="Quick brightness" Height="30" Margin="0,0,0,7"/>
   <TextBlock x:Name="HintText" Text="Adjust until the next schedule change." Foreground="#A6A6A6" FontSize="11" Margin="0,0,0,14"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="Return to schedule" Click="ReturnClick" Background="#363636" Foreground="#ECECEC" BorderBrush="#525252" BorderThickness="1" Padding="10,8" Margin="0,0,5,0" Cursor="Hand"/>
    <Button Grid.Column="1" Content="Open settings" Click="SettingsClick" Background="#B9DAD0" Foreground="#20342F" BorderThickness="0" Padding="10,8" Margin="5,0,0,0" Cursor="Hand"/>
   </Grid>
  </StackPanel>
 </Border>
</Window>
